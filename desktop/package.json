{
  "name": "desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc src/electron/main.ts src/electron/preload.cts --outDir dist-electron --module nodenext --moduleResolution nodenext --target es2022 --esModuleInterop --ignoreConfig && electron .",
    "build": "vite build && tsc src/electron/main.ts src/electron/preload.cts --outDir dist-electron --module nodenext --moduleResolution nodenext --target es2022 --esModuleInterop --ignoreConfig",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "org.fcnabc.automediapublisher",
    "productName": "AutoMediaPublisher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../worker/dist",
        "to": "worker"
      },
      {
        "from": "../binaries/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}