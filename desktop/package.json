{
  "name": "desktop",
  "private": true,
  "productName": "AutoMediaPublisher",
  "version": "0.3.2",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc src/electron/main.ts src/electron/preload.cts --outDir dist-electron --module nodenext --moduleResolution nodenext --target es2022 --esModuleInterop --ignoreConfig && electron .",
    "build": "vite build && tsc src/electron/main.ts src/electron/preload.cts --outDir dist-electron --module nodenext --moduleResolution nodenext --target es2022 --esModuleInterop --ignoreConfig",
    "dist": "npm run build && electron-builder --publish onTagOrDraft"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "kylezhao101",
        "repo": "auto-media-publisher",
        "releaseType": "draft"
      }
    ],
    "appId": "org.kylezhao101.automediapublisher",
    "productName": "AutoMediaPublisher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../worker/dist",
        "to": "worker",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "../binaries/ffmpeg/windows-x64",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "category": "public.app-category.video",
      "extraResources": [
        {
          "from": "../binaries/ffmpeg/macos-arm64",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.7.0",
    "react-select": "^5.10.2",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}